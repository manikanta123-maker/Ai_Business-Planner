# ==========================================
# AI Business Architect Configuration
# ==========================================

# 1. Database (Defaults to SQLite dev.db in backend folder)
DATABASE_URL=sqlite:///./dev.db

# 2. JWT Security Key (Change this to any secure random string in production)
SECRET_KEY=ai_business_architect_secret_key_change_me

# 3. AI Model Provider Keys (Set at least one to enable live AI generation)
# Obtain Gemini key: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Obtain OpenAI key: https://platform.openai.com/
OPENAI_API_KEY=

# 4. Search API Key (Required for live competitor discovery and market trends)
# Obtain Tavily key (1,000 free monthly searches): https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here
